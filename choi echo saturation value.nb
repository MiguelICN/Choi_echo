        RowBox[{"OptionValue", "[", "\"\<Parallel\>\"", "]"}], "]"}]}], "}"}],
      ",", 
     RowBox[{"If", "[", 
      RowBox[{"par", ",", 
       RowBox[{"ParallelMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Chop", "@", 
             RowBox[{"Re", "@", 
              RowBox[{"Tr", "[", 
               RowBox[{"#", ".", "#"}], "]"}]}]}], ")"}], "&"}], "@*", 
          "choiF"}], ",", "tlist", ",", 
         RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}], ",", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Chop", "@", 
             RowBox[{"Re", "@", 
              RowBox[{"Tr", "[", 
               RowBox[{"#", ".", "#"}], "]"}]}]}], ")"}], "&"}], "@*", 
          "choiF"}], ",", "tlist"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
