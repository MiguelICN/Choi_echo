  RowBox[{"(*", " ", 
   RowBox[{"Choi", " ", 
    RowBox[{"echo", " ", "/", " ", "Choi"}], " ", "purity", " ", 
    RowBox[{"Tr", "[", 
     RowBox[{"D", 
      RowBox[{
       RowBox[{"(", "t", ")"}], "^", "2"}]}], "]"}]}], 
   "                              ", "*)"}], "\n", 
  RowBox[{
  "(*", "                                                                  ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Bounds", ":"}], 
   "                                                          ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{"Upper", ":", " ", 
    RowBox[{"1", "        ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"unitary", " ", "channel"}], ",", " ", 
       RowBox[{"t", " ", "=", " ", "0"}]}], ")"}]}]}], 
   "                      ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{"Lower", ":", " ", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"dS", "^", "2"}]}], "   ", 
     RowBox[{"(", 
      RowBox[{"completely", " ", "depolarizing", " ", "channel"}], ")"}]}]}], 
   "             ", "*)"}], "\n", 
  RowBox[{
  "(*", "                                                                  ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "red", " ", "dashed", " ", "line", " ", "marks", " ", "the", " ",
     "depolarizing", " ", "saturation", " ", 
    RowBox[{"value", "."}]}], "    ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"purityData", " ", "=", " ", 
     RowBox[{"ExtractKey", "[", 
      RowBox[{"results", ",", " ", "\"\<Purity\>\""}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"plotPurity", " ", "=", " ", 
