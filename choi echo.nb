Cell[CellGroupData[{

Cell["Time Evolution", "Chapter",ExpressionUUID->"72e19580-c612-5343-ac8c-49ce1ed8beaa"],

Cell["\<\
Evaluates D(t) and its derived observables across tlist.
Select \"Observables\" option to trade accuracy for speed when eigenvalues \
are not needed.\
\>", "Text",ExpressionUUID->"0ff9bb78-782a-b649-9bfa-6694ec76c810"],

Cell[CellGroupData[{

Cell["Compute", "Section",ExpressionUUID->"d205dfaf-45ae-c94f-966b-f10483977a73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Options", ":"}], 
   "                                                          ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{"\"\<Purity\>\"", "   ", "\[LongDash]", " ", 
    RowBox[{"only", " ", 
     RowBox[{"Tr", "[", 
      RowBox[{"D", "^", "2"}], "]"}]}], ",", " ", 
    RowBox[{"fastest", "."}]}], "                           ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{"\"\<Entropy\>\"", "  ", "\[LongDash]", " ", 
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{"D", "^", "2"}], "]"}], " ", "+", " ", 
     RowBox[{"S", 
      RowBox[{"(", "D", ")"}]}]}], ",", " ", 
    RowBox[{"requires", " ", "one", " ", "Eigenvalues", " ", 
     RowBox[{"call", "."}]}]}], "  ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{"\"\<All\>\"", "      ", "\[LongDash]", " ", 
    RowBox[{"all", " ", "observables", " ", "including", " ", "full", " ", 
     RowBox[{"spectrum", "."}]}]}], "          ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"AbsoluteTiming", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"results", " ", "=", " ", 
     RowBox[{"ChoiTimeSeries", "[", 
      RowBox[{"choiF", ",", " ", "tlist", ",", "\n", "    ", 
       RowBox[{"\"\<Observables\>\"", " ", "->", " ", "\"\<All\>\""}], ",", 
       "\n", "    ", 
       RowBox[{"\"\<Parallel\>\"", "    ", "->", " ", "True"}]}], "]"}]}], 
    ";"}], "\n", "]"}]}]], "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"8a4cdb00-4ea9-4146-b727-da4838a6abcc"],

