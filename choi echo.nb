Cell["Results", "Chapter",ExpressionUUID->"ccee9b90-dc76-6c4d-8fdd-bf14078077e7"],

Cell["\<\
Plots and derived quantities. The saturation values of purity and entropy are \
the
key indicators compared against the spectral chaos benchmarks in the paper.\
\>", "Text",ExpressionUUID->"94a4be3d-800b-5d4b-a2cc-7f9949b6dcde"],

Cell[CellGroupData[{

Cell["Choi purity", "Section",ExpressionUUID->"6609b85f-68d6-7949-8225-e4d2e33bed55"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
