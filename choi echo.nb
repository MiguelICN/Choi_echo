       RowBox[{"Transpose", "[", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "ev", "]"}], ",", " ", "ts"}], "]"}], 
        "]"}]}], "]"}]}], ";"}]}]}]], "Input",
