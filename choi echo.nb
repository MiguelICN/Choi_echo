Cell[CellGroupData[{

Cell["Distribute to parallel kernels", "Section",ExpressionUUID->"eec9c6ea-a88e-f14a-a612-d1619ffdcebb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Send", " ", "all", " ", "objects", " ", "required", " ", "inside", " ", 
    "the", " ", "time", " ", "loop", " ", "to", " ", 
    RowBox[{"workers", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"DistributeDefinitions", "[", "\n", "  ", 
    RowBox[{
    "choiF", ",", " ", "ChoiPurity", ",", " ", "ChoiVNEntropy", ",", " ", 
     "ChoiEigenvalues", ",", "\n", "  ", "ChoiObservables", ",", " ", 
     "MatrixPartialTrace", ",", " ", "Dyad"}], "\n", "]"}], ";"}]}]], "Input",
 CellLabel->"In[66]:=",ExpressionUUID->"8bfa7e41-7d67-b645-9a34-25abc1290177"]
