Cell[CellGroupData[{

Cell["Diagonalize", "Section",ExpressionUUID->"c6ca96af-5127-ad47-b346-277605b27569"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Parity", " ", "block"}], "-", 
    RowBox[{
    "diagonalize", " ", "then", " ", "merge", " ", "sorted", " ", "by", " ", 
     RowBox[{"energy", "."}]}]}], "           ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"allvecs", ":", " ", 
    RowBox[{
    "D", " ", "\[Times]", " ", "D", " ", "matrix", " ", "with", " ", 
     "eigenvectors", " ", "as", " ", 
     RowBox[{"rows", "."}]}]}], "               ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"allvals", ":", " ", 
    RowBox[{"D", "-", 
     RowBox[{"vector", " ", "of", " ", 
      RowBox[{"eigenvalues", "."}]}]}]}], "                               ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"system", " ", "=", " ", 
     RowBox[{"BlockDiagonalize", "[", 
      RowBox[{"Ha", ",", " ", 
       RowBox[{"Symmetry", " ", "->", " ", "\"\<Parity\>\""}]}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eveneigenval", ",", " ", "eveneigenvec"}], "}"}], " ", "=", 
     "\n", "  ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Sort", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"system", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"oddeigenval", ",", " ", "oddeigenvec"}], "}"}], " ", "=", "\n",
      "  ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Sort", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"system", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Reconstruct", " ", "full", " ", "eigenvectors", " ", "from", " ", 
      "block"}], "-", 
     RowBox[{"sector", " ", "vectors"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"evenMap", ",", " ", "oddMap"}], "}"}], " ", "=", " ", 
     RowBox[{"buildMaps", "[", "L", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"neweven", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ExpandBlockVector", "[", 
        RowBox[{
        "i", ",", " ", "evenMap", ",", " ", "\"\<even\>\"", ",", " ", "L"}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "eveneigenvec"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"newodd", "  ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ExpandBlockVector", "[", 
        RowBox[{
        "i", ",", " ", "oddMap", ",", "  ", "\"\<odd\>\"", ",", "  ", "L"}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "oddeigenvec"}], "}"}]}], "]"}]}], ";"}], "\n",
    "\n", 
   RowBox[{
    RowBox[{"allvecs", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{"neweven", ",", " ", "newodd"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"allvals", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{"eveneigenval", ",", " ", "oddeigenval"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"newall", "  ", "=", " ", 
     RowBox[{"SortBy", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"allvals", ",", " ", "allvecs"}], "}"}], "]"}], ",", " ", 
       "First"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"allvecs", " ", "=", " ", 
     RowBox[{"newall", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"allvals", " ", "=", " ", 
     RowBox[{"newall", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Eigensystem: \>\"", ",", " ", 
      RowBox[{"Length", "[", "allvals", "]"}], ",", 
      " ", "\"\< levels, energy range [\>\"", ",", "\n", "      ", 
      RowBox[{"N", "@", 
       RowBox[{"Min", "[", "allvals", "]"}]}], ",", " ", "\"\<, \>\"", ",", 
      " ", 
      RowBox[{"N", "@", 
       RowBox[{"Max", "[", "allvals", "]"}]}], ",", " ", "\"\<]\>\""}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Mean level spacing ratio: \>\"", ",", " ", 
      RowBox[{"MeanLevelSpacingRatio", "[", "allvals", "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
