Cell[CellGroupData[{

Cell["Hamiltonian", "Chapter",ExpressionUUID->"c1c71935-b08a-384b-a927-dc988a863e4d"],

Cell["\<\
Build and diagonalize the Hamiltonian. Exploits parity symmetry for the Ising \
model.
For a different model, replace the Hamiltonian definition block only.\
\>", "Text",ExpressionUUID->"c799ada6-cfc7-5a4c-9e37-f46a14c0213a"],

Cell[CellGroupData[{

Cell["Build", "Section",ExpressionUUID->"49616a3f-ed28-3944-a7e0-eb4ebbd83843"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"ISING", " ", "HAMILTONIAN", " ", 
    RowBox[{"(", 
     RowBox[{"open", " ", "boundary", " ", "conditions"}], ")"}]}], 
   "                     ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{"H", " ", "=", " ", 
    RowBox[{
     RowBox[{"\[Sum]", 
      RowBox[{"_i", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"hx", " ", 
          RowBox[{"\[Sigma]", "^", "x_i"}]}], " ", "+", " ", 
         RowBox[{"hz", " ", 
          RowBox[{"\[Sigma]", "^", "z_i"}]}]}], ")"}]}]}], " ", "-", " ", 
     RowBox[{"J", " ", 
      RowBox[{"\[Sum]", 
       RowBox[{"_i", " ", 
        RowBox[{"\[Sigma]", "^", "z_i"}], " ", 
        RowBox[{"\[Sigma]", "^", "z_"}], 
        RowBox[{"{", 
         RowBox[{"i", "+", "1"}], "}"}]}]}]}]}]}], "   ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"IsingHamiltonian", " ", "is", " ", "defined", " ", "in", " ", 
    RowBox[{"QMB_offline", ".", "wl", "."}]}], "                  ", "*)"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"To", " ", "switch", " ", 
    RowBox[{"model", ":", " ", 
     RowBox[{
     "replace", " ", "this", " ", "block", " ", "with", " ", "a", " ", 
      "different", " ", 
      RowBox[{"H", "."}]}]}]}], "          ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Ha", " ", "=", " ", 
     RowBox[{"IsingHamiltonian", "[", 
      RowBox[{"hx", ",", " ", "hz", ",", " ", "J", ",", " ", "L", ",", " ", 
       RowBox[{"BoundaryConditions", " ", "->", " ", "\"\<Open\>\""}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Hamiltonian dimensions: \>\"", ",", " ", 
      RowBox[{"Dimensions", "[", "Ha", "]"}]}], "]"}], ";"}]}]}]], "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"1bbb5c2e-16f9-2c41-bef9-d72ee6618ada"],

