Cell[CellGroupData[{

Cell["Environment Initial State", "Chapter",ExpressionUUID->"634024cf-adbd-6144-ba30-ab24c5bdedf8"],

Cell["\<\
Defines \[Rho]_E, the initial environment state. The Choi matrix D(t) depends \
on this choice.
For the Haar-averaged Choi echo of the paper (Eq. 7), one would average over \
many instances
of the random product state defined here. For a single run we fix one \
realization.\
\>", "Text",ExpressionUUID->"dbec9425-c98d-484c-adf4-80820ff0266a"],

Cell[CellGroupData[{

Cell["Random product state (infinite-temperature representative)", "Section",ExpressionUUID->"3a67bade-0030-814c-a3bd-284f77695296"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Choose", " ", "the", " ", "initial", " ", "state", " ", "of", " ", "the", 
    " ", 
    RowBox[{"environment", "."}]}], "                    ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Here", ":", " ", 
    RowBox[{
    "a", " ", "random", " ", "product", " ", "state", " ", "of", " ", "Lb", " ",
      "qubits", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"single", " ", "realization"}], ")"}], "."}]}]}], " ", "*)"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"This", " ", "corresponds", " ", "to", " ", "a", " ", "single"}], 
    "-", 
    RowBox[{
    "shot", " ", "sample", " ", "of", " ", "the", " ", "Haar", " ", 
     "average"}]}], "    ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"in", " ", 
    RowBox[{"Eq", ".", " ", 
     RowBox[{"(", "7", ")"}]}], " ", "of", " ", "the", " ", 
    RowBox[{"paper", "."}]}], "                                        ", 
   "*)"}], "\n", 
  RowBox[{
  "(*", "                                                                  ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternative", ":", " ", 
     RowBox[{
     "set", " ", "psiE", " ", "to", " ", "a", " ", "specific", " ", "product",
       " ", "state"}]}], ",", " ", 
    RowBox[{"e", ".", "g", "."}]}], "        ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{"psiE", " ", "=", " ", 
    RowBox[{
     RowBox[{"coherentstate", "[", 
      RowBox[{
       RowBox[{"qubit", "[", 
        RowBox[{"0.", ",", "0."}], "]"}], ",", " ", "Lb"}], "]"}], "   ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"all", " ", "spin"}], "-", 
       RowBox[{"up", " ", "state"}]}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psiE", "=", 
     RowBox[{"RandomChainProductState", "[", "Lb", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Build", " ", "the", " ", "global", " ", "initial", " ", "state", " ", 
     "for", " ", "the", " ", "full", " ", "chain", " ", 
     RowBox[{"S", " ", "\[CircleTimes]", " ", 
      RowBox[{"E", "."}]}]}], "    ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"The", " ", "subsystem", " ", "S", " ", "starts", " ", "in", " ", 
      RowBox[{"IS", "/", "dS"}], " ", 
      RowBox[{"(", 
       RowBox[{"maximally", " ", "mixed"}], ")"}]}], ",", " ", "consistent"}],
     "  ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"with", " ", "the", " ", "Choi", " ", "construction", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Eq", ".", " ", "2"}], " ", "of", " ", "the", " ", "paper"}], 
       ")"}], "."}]}], "               ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "We", " ", "do", " ", "NOT", " ", "need", " ", "an", " ", "explicit", " ",
      "global", " ", 
     RowBox[{"state", ":", " ", 
      RowBox[{"rhoE", " ", "is", " ", "sufficient"}]}]}], "     ", "*)"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"for", " ", "the", " ", 
     RowBox[{"ChoiChannelBuilder", "."}]}], 
    "                                     ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rhoE", "=", 
     RowBox[{"PackC", "@", 
      RowBox[{"Dyad", "[", "psiE", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<rhoE dimensions: \>\"", ",", 
      RowBox[{"Dimensions", "[", "rhoE", "]"}], ",", "\"\<  (should be {\>\"",
       ",", "dE", ",", "\"\<,\>\"", ",", "dE", ",", "\"\<})\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Tr[rhoE] = \>\"", ",", 
      RowBox[{"N", "@", 
       RowBox[{"Tr", "[", "rhoE", "]"}]}], ",", "\"\<  (should be 1)\>\""}], 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.989158385004713*^9, 3.989158410988577*^9}, {
  3.9891586149581413`*^9, 3.989158616032419*^9}, {3.989158650195757*^9, 
  3.989158653525772*^9}, {3.989158821449854*^9, 3.9891588288173313`*^9}},
 CellLabel->
  "In[113]:=",ExpressionUUID->"cda134f0-acd6-044a-9008-f7b6dade51c0"],

