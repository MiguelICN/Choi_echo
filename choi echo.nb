Cell[CellGroupData[{

Cell["Dynamical Map: Choi Matrix", "Chapter",ExpressionUUID->"08748485-2c50-b547-b4be-363f3554e327"],

Cell["\<\
Constructs the time-dependent Choi matrix D(t) via the ChoiChannelBuilder.
The unitary U(t) is built spectrally from the eigensystem computed above.\
\>", "Text",ExpressionUUID->"48e96c2d-acf3-614a-8ebf-fc843778fee9"],

Cell[CellGroupData[{

Cell["Build unitary and Choi function", "Section",ExpressionUUID->"00ce3293-0439-0e46-8ea2-161469a0ed14"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Spectral", " ", "unitary", " ", "U", 
     RowBox[{"(", "t", ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"P", " ", ".", " ", "Diag"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"e", "^", 
        RowBox[{"{", 
         RowBox[{"-", "i\[Lambda]t"}], "}"}]}], ")"}], " ", ".", " ", 
      RowBox[{"P", "^", "\[Dagger]"}]}]}]}], "             ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"unitaryF", " ", "=", " ", 
     RowBox[{"SpectralUnitary", "[", 
      RowBox[{"allvecs", ",", " ", "allvals"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Choi", " ", "matrix", " ", "function", " ", "D", 
      RowBox[{"(", "t", ")"}], " ", "via", " ", "system"}], "-", 
     RowBox[{"environment", " ", "representation"}]}], "  ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"paper", " ", 
        RowBox[{"Eq", ".", " ", "2"}]}], ",", " ", 
       RowBox[{"implemented", " ", "in", " ", "BLOCK", " ", "3"}]}], ")"}], 
     "."}], "                          ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"choiF", " ", "=", " ", 
     RowBox[{"ChoiChannelBuilder", "[", 
      RowBox[{"dS", ",", " ", "dE", ",", " ", "unitaryF", ",", " ", 
       RowBox[{"\"\<rhoE\>\"", " ", "->", " ", "rhoE"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{" ", 
      RowBox[{
       RowBox[{"Sanity", " ", "check", " ", "at", " ", "t"}], " ", "=", " ", 
       RowBox[{"0", ":", " ", 
        RowBox[{
         RowBox[{"D", 
          RowBox[{"(", "0", ")"}], " ", "should", " ", "be"}], " ", "|", 
         RowBox[{"\[CapitalPhi]", "+"}]}]}]}], "\[RightAngleBracket]"}], 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       RowBox[{"\[CapitalPhi]", "+"}], "|"}], "             "}]}], "*)"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"unitary", " ", "channel", " ", "since", " ", "U", 
        RowBox[{"(", "0", ")"}]}], " ", "=", " ", "I"}], ")"}], ",", " ", 
     RowBox[{
      RowBox[{"so", " ", 
       RowBox[{"Tr", "[", 
        RowBox[{"D", 
         RowBox[{
          RowBox[{"(", "0", ")"}], "^", "2"}]}], "]"}]}], " ", "=", " ", 
      "1."}]}], "          ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"D0", " ", "=", " ", 
     RowBox[{"choiF", "[", "0.", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<t=0 check: Tr[D(0)^2] = \>\"", ",", " ", 
      RowBox[{"ChoiPurity", "[", "D0", "]"}], ",", 
      " ", "\"\<  (should be 1)\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<t=0 check: Tr[D(0)] = \>\"", ",", " ", 
      RowBox[{"N", "@", 
       RowBox[{"Re", "@", 
        RowBox[{"Tr", "[", "D0", "]"}]}]}], ",", 
      " ", "\"\<  (should be 1)\>\""}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[118]:=",ExpressionUUID->"04431557-8fd3-0f4f-a7e7-66f616d69deb"],

