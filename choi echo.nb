Cell[CellGroupData[{

Cell["Eigenvalue spectrum of the Choi state", "Section",ExpressionUUID->"3286394d-41a2-8a47-b2b9-439184c44bf8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Eigenvalue", " ", "spectrum", " ", "of", " ", "D", 
    RowBox[{"(", "t", ")"}], " ", "as", " ", "a", " ", "function", " ", "of", 
    " ", 
    RowBox[{"time", "."}]}], "              ", "*)"}], "\n", 
  RowBox[{
  "(*", "                                                                  ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"D", 
    RowBox[{"(", "t", ")"}], " ", "is", " ", "a", " ", "valid", " ", 
    "density", " ", "matrix", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"CPTP", " ", "map", " ", "via", " ", "Choi"}], "-", 
       RowBox[{"Jamio", 
        RowBox[{"\\[", "LKSlash", "]"}], "kowski"}]}], ")"}], "."}]}], "  ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Its", " ", "eigenvalues", " ", "are", " ", "real"}], ",", " ", 
    RowBox[{"non", "-", "negative"}], ",", " ", 
    RowBox[{"and", " ", "sum", " ", "to", " ", "1."}]}], "           ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Rank", " ", "=", " ", 
    RowBox[{
    "number", " ", "of", " ", "Kraus", " ", "operators", " ", "in", " ", 
     "the", " ", "minimal", " ", 
     RowBox[{"dilation", "."}]}]}], "       ", "*)"}], "\n", 
  RowBox[{
  "(*", "                                                                  ", 
   "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{" ", 
     RowBox[{
      RowBox[{"At", " ", "t"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"0", ":", " ", "D"}], " ", "=", " ", 
       RowBox[{"|", 
        RowBox[{"\[CapitalPhi]", "+"}]}]}]}], "\[RightAngleBracket]"}], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      RowBox[{"\[CapitalPhi]", "+"}], "|", " ", 
      RowBox[{"\[RightArrow]", " ", 
       RowBox[{"rank", " ", "1", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"unitary", " ", "channel"}], ")"}], "."}]}]}]}], 
     "          "}]}], "*)"}], "\n", 
  RowBox[{
  "(*", "                                                                  ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"For", " ", "dS"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"La", " ", "=", " ", "1"}], ")"}]}], ":", " ", 
     RowBox[{
      RowBox[{"D", " ", "is", " ", "4", "\[Times]", "4"}], " ", "\[RightArrow]",
       " ", 
      RowBox[{"at", " ", "most", " ", "4", " ", 
       RowBox[{"eigenvalues", "."}]}]}]}]}], "      ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"eigenvalData", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"results", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<Eigenvalues\>\"", "]"}], 
         ",", "\n", "          ", 
         RowBox[{
          RowBox[{"results", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<Time\>\"", "]"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Length", "[", "results", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Plot", " ", "each", " ", "eigenvalue", " ", "track", " ", "as", " ", "a",
      " ", "function", " ", "of", " ", "time"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nEV", " ", "=", " ", 
     RowBox[{"dS", "^", "2"}]}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "max", " ", "number", " ", "of", " ", "eigenvalues", " ", "for", " ", 
     "this", " ", "bipartition"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"evColors", " ", "=", " ", 
     RowBox[{
      RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], " ", "/@", " ", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"0.", ",", " ", "1.", ",", " ", 
        RowBox[{"nEV", " ", "-", " ", "1"}]}], "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"evTracks", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"eigenvalData", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
         RowBox[{"eigenvalData", "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", " ", 
            RowBox[{"j", " ", "+", " ", "1"}]}], "]"}], "]"}]}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "1", ",", " ", "nEV"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Length", "[", "results", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"ListLogLinearPlot", "[", 
    RowBox[{"evTracks", ",", "\n", "  ", 
     RowBox[{"Joined", "        ", "->", " ", "True"}], ",", "\n", "  ", 
     RowBox[{"PlotTheme", "     ", "->", " ", "\"\<Detailed\>\""}], ",", "\n",
      "  ", 
     RowBox[{"PlotLabel", "     ", "->", " ", 
      RowBox[{"Style", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<Choi Eigenvalues \[LongDash] L = \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "L", "]"}], " ", "<>", "\n", 
         "    ", "\"\<, La = \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "La", "]"}]}], ",", " ", "22", ",", " ", 
        "Black"}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"FrameStyle", "    ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", " ", 
        RowBox[{"FontSize", " ", "->", " ", "20"}]}], "]"}]}], ",", "\n", 
     "  ", 
     RowBox[{"FrameLabel", "    ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<t\>\"", ",", " ", "18"}], "]"}], ",", " ", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\\"\[Lambda]\\\", \
\\\"k\\\"]\\)(t)\>\"", ",", " ", "18"}], "]"}]}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotStyle", "     ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"evColors", "[", 
             RowBox[{"[", "#", "]"}], "]"}], ",", " ", "Thick"}], "]"}], 
          "}"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"Range", "[", "nEV", "]"}]}], ")"}]}], ",", "\n", "  ", 
     RowBox[{"PlotRange", "     ", "->", " ", "All"}], ",", "\n", "  ", 
     RowBox[{"ImageSize", "     ", "->", " ", "800"}], ",", "\n", "  ", 
     RowBox[{"PlotLegends", "   ", "->", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          
          RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\\"\[Lambda]\\\", \>\"", " ", "<>",
            " ", 
           RowBox[{"ToString", "[", "k", "]"}], " ", "<>", 
           " ", "\"\<]\\)\>\""}], ",", " ", "16"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "nEV"}], "}"}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
