Cell[CellGroupData[{

Cell["Von Neumann entropy of the Choi state", "Section",ExpressionUUID->"1b23a082-1de7-0947-ae06-a60a05ca3f73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Channel", " ", "entropy", " ", "S", 
     RowBox[{"(", 
      RowBox[{"D", 
       RowBox[{"(", "t", ")"}]}], ")"}]}], " ", "=", " ", 
    RowBox[{"-", 
     RowBox[{"Tr", "[", 
      RowBox[{"D", " ", "log", " ", "D"}], "]"}]}]}], 
   "                         ", "*)"}], "\n", 
  RowBox[{
  "(*", "                                                                  ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Bounds", ":"}], 
   "                                                          ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{"Lower", ":", " ", 
    RowBox[{"0", "         ", 
     RowBox[{"(", 
      RowBox[{"unitary", " ", "channel"}], ")"}]}]}], 
   "                            ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{"Upper", ":", " ", 
    RowBox[{"log", 
     RowBox[{"(", 
      RowBox[{"dS", "^", "2"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"completely", " ", "depolarizing", " ", "channel"}], ")"}]}]}], 
   "           ", "*)"}], "\n", 
  RowBox[{
  "(*", "                                                                  ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "dashed", " ", "line", " ", "marks", " ", "the", " ", 
    "depolarizing", " ", "saturation", " ", 
    RowBox[{"value", "."}]}], "        ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"entropyData", " ", "=", " ", 
     RowBox[{"ExtractKey", "[", 
      RowBox[{"results", ",", " ", "\"\<VNEntropy\>\""}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"plotEntropy", " ", "=", " ", 
     RowBox[{"ListLogLinearPlot", "[", 
      RowBox[{"entropyData", ",", "\n", "  ", 
       RowBox[{"Joined", "        ", "->", " ", "True"}], ",", "\n", "  ", 
       RowBox[{"PlotTheme", "     ", "->", " ", "\"\<Detailed\>\""}], ",", 
       "\n", "  ", 
       RowBox[{"PlotLabel", "     ", "->", " ", 
        RowBox[{"Style", "[", "\n", "    ", 
         RowBox[{
          
          RowBox[{"\"\<Choi Channel Entropy S(\\!\\(\\*SubscriptBox[\\\"\
\[ScriptCapitalD]\\\", \\\"t\\\"]\\)) \[LongDash] L = \>\"", " ", "<>", " ", 
