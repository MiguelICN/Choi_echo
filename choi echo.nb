         RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", " ", 
         RowBox[{"#", "[", "key", "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
      "results"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"EigenvalueMatrix", "[", "results_List", "]"}], " ", ":=", "\n", 
     "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Returns", " ", "a", " ", 
         RowBox[{"matrix", ":", " ", "rows"}]}], " ", "=", " ", 
        RowBox[{"time", " ", "steps"}]}], ",", " ", 
       RowBox[{"cols", " ", "=", " ", 
