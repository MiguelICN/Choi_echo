      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"ExtractKey", ",", " ", "EigenvalueMatrix"}], "]"}], ";"}], "\n",
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ExtractKey", "[", 
      RowBox[{"results_List", ",", " ", "key_String"}], "]"}], " ", ":=", 
     "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
